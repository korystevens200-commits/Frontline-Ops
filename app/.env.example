# Copy to .env for local development. NEVER commit .env.
DATABASE_URL=postgres://frontline:frontline@localhost:5432/frontline
# Generate with: npm run hash-password -- 'your-password-here'
APP_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated operator names shown on the login screen.
APP_USERS=Kory,Isa
PORT=8080

# --- Text-back ---------------------------------------------------------------
# Locally: fake records texts instead of sending them. Drive it with
#   npm run simulate -- call +13055550142 <line number>
SMS_PROVIDER=fake
# Real Twilio (leave SMS_PROVIDER unset). Without these, text-back is off and
# everything else works as normal.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_MESSAGING_SERVICE_SID=
# Where Twilio can reach this app. On Fly it defaults to https://<app>.fly.dev.
# PUBLIC_BASE_URL=
